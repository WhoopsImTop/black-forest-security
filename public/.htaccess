# Black Forest Security – Apache-Konfiguration für das statische Nuxt-Build
# Ziel: genau eine kanonische Host-Variante (https://www.black-forest-security.de)

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) http → https und ohne www → www in EINEM 301-Hop
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.black-forest-security.de%{REQUEST_URI} [R=301,L,NE]

  # 2) Keyword-Kannibalisierung vermeiden: Startseite ist die Freiburg-Hauptseite
  RewriteRule ^standorte/freiburg/?$ https://www.black-forest-security.de/ [R=301,L]

  # 3) Alte, noch indexierte URLs
  RewriteRule ^sicherheitsdienst-freiburg/?$ https://www.black-forest-security.de/ [R=301,L]

  # Alte Pfade, die noch in Google-Ads-Anzeigen / Sitelinks stehen (Query-String wie gclid bleibt erhalten)
  RewriteRule ^leistungen/(objektschutz|veranstaltungsschutz|tuersteher|baustellenueberwachung|streifen-und-revierdienst)/?$ /$1/ [R=301,L]
  RewriteRule ^leistungen/?$ /#leistungen [R=301,L,NE]
  RewriteRule ^sicherheit/objektschutz/?$ /objektschutz/ [R=301,L]

  # Kurzlink für QR-Codes, E-Mail-Signatur, Rechnungen: Google-Rezension schreiben
  RewriteRule ^bewertung/?$ https://search.google.com/local/writereview?placeid=ChIJC1ZdhvMfkUcRtpA9dY8D4VY [R=302,L]

  # 4) Unbekannte Pfade: echte 404 statt Startseite (verhindert Soft-404)
  #    Greift, weil ErrorDocument unten auf 404.html zeigt und kein SPA-Fallback gesetzt ist.

  # 5) Alte Bild-URLs mit Umlaut / Tippfehler
  RewriteRule ^t(ü|%C3%BC)rsteher\.jpg$ /tuersteher.jpg [R=301,L,NC]
</IfModule>

<IfModule mod_headers.c>
  # HSTS – erst nach erfolgreichem Test auf includeSubDomains/preload erweitern
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Nuxt-Build-Assets sind gehasht und damit unveränderlich
  <If "%{REQUEST_URI} =~ m#^/_nuxt/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

ErrorDocument 404 /404.html
